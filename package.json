{
  "name": "alienmon",
  "version": "0.1.0",
  "private": true,
  "description": "Alienmon - catch and bond with alien battle partners across the stars",
  "scripts": {
    "build": "node tools/build.js",
    "build:inline": "node tools/build.js --inline",
    "android": "node tools/build.js --inline && npx cap sync android && npx cap open android",
    "import-renders": "python tools/import_renders.py",
    "towns": "python tools/paint_town.py --all",
    "dev": "node tools/build.js && npx serve www"
  },
  "dependencies": {
    "@capacitor/android": "latest",
    "@capacitor/app": "latest",
    "@capacitor/core": "latest"
  },
  "devDependencies": {
    "@capacitor/cli": "latest"
  }
}
